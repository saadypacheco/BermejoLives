ENVIRONMENT=development

# Supabase (service_role NUNCA va al frontend)
SUPABASE_URL=
SUPABASE_PUBLIC_URL=          # cómo alcanza el navegador a Supabase (URLs de fotos). Vacío = usa SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=

# Bridge WhatsApp (WAHA) en red privada
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WEBHOOK_SECRET=

# Auth del panel de moderación
JWT_SECRET=bermejo-dev-secret-change-in-prod
ADMIN_EMAIL=admin@bermejolive.com
ADMIN_PASSWORD=bermejo1234

# Pepper de las claves de Mi comercio: HMAC-SHA256(pepper, clave) antes de PBKDF2.
# Secreto del backend (no va en la base ni en el frontend). Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacío = las claves se guardan sin pepper (y el arranque avisa). No lo cambies después
# de ponerlo: las claves ya guardadas con el pepper viejo dejarían de servir.
CLAVE_PEPPER=

# Agente de campo
AGENTE_EMAIL=agente@bermejolive.com
AGENTE_PASSWORD=campo1234

FRONTEND_URL=http://localhost:3000
STORAGE_BUCKET=publicaciones
COMERCIOS_BUCKET=comercios

OPENAI_API_KEY=
