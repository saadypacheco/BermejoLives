ENVIRONMENT=development

# Supabase (service_role NUNCA va al frontend)
SUPABASE_URL=
SUPABASE_PUBLIC_URL=          # cómo alcanza el navegador a Supabase (URLs de fotos). Vacío = usa SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=
# PostgREST por la red interna del compose (SIN /rest/v1): el backend le habla directo y no sale a
# internet. Vacío = usa SUPABASE_URL como siempre. En el VPS: http://buscadonde-postgrest:3000
POSTGREST_INTERNAL_URL=

# Bridge WhatsApp (WAHA) en red privada
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=

# Fotos de números desconocidos (disco PRIVADO, nunca bajo /data/fotos) y eventos de grupo
WA_RECEIVED_DIR=/data/wa_received
WA_RECEIVED_RETENTION_DAYS=30
WA_RECEIVED_MAX_PER_SENDER_PER_DAY=30   # fotos guardadas por remitente desconocido en 24 h; lo que excede queda sin archivo
WA_EVENTS_RETENTION_DAYS=90             # vacía raw/participants de wa_group_events y los LID inactivos a los N días
WA_EVENTS_ACT=false            # E1 sólo guarda los eventos de grupo; actuar sobre ellos llega en E2
WA_LID_LOOKUP=false            # traducir LID a número consultando a WAHA (sólo lectura); lo decide el E0
WA_LID_LOOKUP_MAX_PER_HOUR=30
WEBHOOK_SECRET=

# Auth del panel de moderación
JWT_SECRET=bermejo-dev-secret-change-in-prod
# Claves HMAC propias de dos tokens públicos (no son la del JWT). Vacías = se derivan de JWT_SECRET.
# En producción fijalas: openssl rand -hex 32
LEAD_TOKEN_SECRET=
RECUPERAR_TOKEN_SECRET=
# Hasta esta fecha el «¿te contestó?» acepta votos sin token (el frontend viejo); después es obligatorio.
LEAD_TOKEN_OBLIGATORIO_DESDE=2026-11-13
# Comprobantes de pago y fotos de «Cambié de número»: disco PRIVADO. Vacío = subcarpeta privados/ de WA_RECEIVED_DIR.
PRIVADOS_DIR=
ADMIN_EMAIL=admin@bermejolive.com
ADMIN_PASSWORD=bermejo1234

# Pepper de las claves de Mi comercio: HMAC-SHA256(pepper, clave) antes de PBKDF2.
# Secreto del backend (no va en la base ni en el frontend). Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacío = las claves se guardan sin pepper (y el arranque avisa). No lo cambies después
# de ponerlo: las claves ya guardadas con el pepper viejo dejarían de servir.
CLAVE_PEPPER=

# Agente de campo
AGENTE_EMAIL=agente@bermejolive.com
AGENTE_PASSWORD=campo1234

FRONTEND_URL=http://localhost:3000
STORAGE_BUCKET=publicaciones
COMERCIOS_BUCKET=comercios

OPENAI_API_KEY=

# QR de cobro (docs/cobro-mensual.md). Es un ARCHIVO del servidor, no se cambia
# desde el panel. En el VPS vive en ./data/pago/ (montado solo lectura en /data/pago).
# Vacío o inexistente = no hay QR y no se muestra nada. Fuera de /data/fotos.
PAGO_QR_PATH=/data/pago/qr.png
PAGO_TITULAR=
PAGO_BANCO=
PAGO_NOTA=

# IndexNow (docs/visibilidad-buscadores-ia.md §3.12): avisa a Bing cuando una ficha cambia.
# Sólo en producción: APP_ENV=prod y una clave de 32 hex al azar (python -c "import secrets;print(secrets.token_hex(16))").
# El sitio tiene que servir esa clave en https://uruku.bo/<clave>.txt (ver el doc). Vacío = apagado.
APP_ENV=
INDEXNOW_KEY=

# Contenido para redes y cuidado de suscriptores (docs/contenido-redes-tecnico.md §11.1).
# El banco de fotos y los videos viven en un disco PRIVADO (volumen `content_private`): NUNCA bajo
# /data/fotos, que se sirve público. Los dos workers arrancan APAGADOS: se prenden cuando el volumen
# está montado y las autorizaciones de redes de los suscriptores ya están cargadas (Admin > Banco).
CONTENT_DIR=/data/content
CONTENT_PLANNER_WORKER=false     # planifica la semana (domingo 20:00 Bolivia) y corre el cuidado diario (07:00)
CONTENT_RENDER_WORKER=false      # arma los videos de a uno (ffmpeg + Pillow, subproceso con nice/ionice)
# Teléfonos en las fotos (docs/telefonos-en-fotos.md): lee las portadas con Tesseract (gratis) y deja los números
# como propuestas en Admin > Comercios > Teléfonos en fotos. Con el interruptor «gemini_phone_scan» las lee Gemini.
TELEFONOS_FOTO_WORKER=false
CONTENT_RENDER_POLL_SEG=30
CONTENT_RENDER_TIMEOUT_SEG=300
CONTENT_RENDER_MAX_ATTEMPTS=3
CONTENT_RENDER_MEMORY_MB=1536
CONTENT_DIR_MAX_GB=10            # tope de la carpeta del banco; las subidas dan 507 al llegar
CONTENT_MIN_FREE_GB=3            # menos que esto de disco libre: se pausa el render y las subidas
CONTENT_SIGNED_URL_TTL_SEG=900   # las URLs firmadas del panel vencen a los 15 min
CONTENT_SHARE_DAYS=60            # vida del enlace /pieza/<token> del comerciante
CONTENT_RENDER_RETENTION_DAYS=90
CONTENT_ASSET_PURGE_DAYS=30
CONTENT_NETWORKS=tiktok,instagram,facebook,wa_channel
CONTENT_PLANNING_WEEKDAY=6       # domingo (lunes = 0)
CONTENT_PLANNING_HOUR=20         # hora de Bolivia
CONTENT_CARE_HOUR=7
CONTENT_GRACE_DAYS=7
CONTENT_CLAIM_MINUTES=20
# Motor del video (docs/contenido-redes-tecnico.md §16): `kit` = contenedor `reels` (Chromium + ffmpeg, plantillas
# v2 del kit; el backend le pide el render por HTTP) o `pillow` = el motor v1 dentro del backend (PC sin Docker).
# Con `kit` y sin RENDERER_TOKEN el worker no toma trabajos. El token tiene que ser el MISMO que en renderer/.env:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CONTENT_RENDER_ENGINE=kit
RENDERER_URL=http://buscadonde-reels:8090
RENDERER_TOKEN=
# uid del usuario del contenedor `reels` (pwuser de la imagen de Playwright noble = 1001): dueño de tmp/<id>/out/.
# El token tiene que tener 32 caracteres o más (si no, el worker no toma trabajos y el contenedor no arranca).
RENDERER_UID=1001
