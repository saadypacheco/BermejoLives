{
  // Tests unitarios (npm test): se compilan con tsc a build/test (carpeta ignorada
  // por el control de versiones) y se corren con `node --test`, sin dependencias nuevas.
  // Sólo entran los módulos puros (lib/seo, lib/horario, components/json-ld...).
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build/test",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx"]
}
