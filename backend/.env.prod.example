# backend/.env de PRODUCCIÓN
# cp backend/.env.prod.example backend/.env && nano backend/.env
# limpiar comentarios inline: sed -i -E 's/[[:space:]]+#.*$//' backend/.env
ENVIRONMENT=production

# Supabase Cloud (Settings → API) — la app usa REST con estas:
SUPABASE_URL=https://TUPROYECTO.supabase.co
SUPABASE_PUBLIC_URL=https://TUPROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Solo para CORRER MIGRACIONES (Session pooler, IPv4). La app NO lo usa en runtime.
DATABASE_URL=postgresql://postgres.TUPROYECTO:TU_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# Auth del panel y del agente de campo (generá JWT_SECRET con: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_openssl_rand_hex_32
# Pepper de las claves de Mi comercio (openssl rand -hex 32). No lo cambies después de ponerlo.
CLAVE_PEPPER=CAMBIAR_openssl_rand_hex_32
ADMIN_EMAIL=admin@buscadonde.com
ADMIN_PASSWORD=CAMBIAR
AGENTE_EMAIL=agente@buscadonde.com
AGENTE_PASSWORD=CAMBIAR

# Varios dominios separados por coma (de cada uno se permite apex y www). Durante
# la migración: el nuevo y el viejo. Ver docs/migracion-encontralo-store.md
FRONTEND_URL=https://encontralo.store,https://buscadonde.com
STORAGE_BUCKET=publicaciones
COMERCIOS_BUCKET=comercios

# WhatsApp (WAHA) — cuando lo despliegues. En producción, sin WEBHOOK_SECRET el
# endpoint /ingest/webhook RECHAZA todo (fail-closed). Generá: openssl rand -hex 24
WEBHOOK_SECRET=
WAHA_BASE_URL=http://buscadonde-waha:3000
WAHA_API_KEY=

# Transcripción del '¿qué vende?' (Whisper). Vacío = el agente escribe a mano.
OPENAI_API_KEY=

# Contenido para redes y cuidado de suscriptores (docs/contenido-redes-tecnico.md §11.1).
# El banco de fotos y los videos viven en un disco PRIVADO (volumen `content_private`): NUNCA bajo
# /data/fotos, que se sirve público. Los dos workers arrancan APAGADOS: se prenden cuando el volumen
# está montado y las autorizaciones de redes de los suscriptores ya están cargadas (Admin > Banco).
CONTENT_DIR=/data/content
CONTENT_PLANNER_WORKER=false     # planifica la semana (domingo 20:00 Bolivia) y corre el cuidado diario (07:00)
CONTENT_RENDER_WORKER=false      # arma los videos de a uno (ffmpeg + Pillow, subproceso con nice/ionice)
CONTENT_RENDER_POLL_SEG=30
CONTENT_RENDER_TIMEOUT_SEG=300
CONTENT_RENDER_MAX_ATTEMPTS=3
CONTENT_RENDER_MEMORY_MB=1536
CONTENT_DIR_MAX_GB=10            # tope de la carpeta del banco; las subidas dan 507 al llegar
CONTENT_MIN_FREE_GB=3            # menos que esto de disco libre: se pausa el render y las subidas
CONTENT_SIGNED_URL_TTL_SEG=900   # las URLs firmadas del panel vencen a los 15 min
CONTENT_SHARE_DAYS=60            # vida del enlace /pieza/<token> del comerciante
CONTENT_RENDER_RETENTION_DAYS=90
CONTENT_ASSET_PURGE_DAYS=30
CONTENT_NETWORKS=tiktok,instagram,facebook,wa_channel
CONTENT_PLANNING_WEEKDAY=6       # domingo (lunes = 0)
CONTENT_PLANNING_HOUR=20         # hora de Bolivia
CONTENT_CARE_HOUR=7
CONTENT_GRACE_DAYS=7
CONTENT_CLAIM_MINUTES=20
