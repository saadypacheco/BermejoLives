# Base (PostgREST). Se leen SÓLO en el servidor (lib/supabase.ts es `server-only`); el
# navegador no recibe ni la URL ni la anon key (npm run check:bundle lo verifica).
# Preferí SUPABASE_URL / SUPABASE_ANON_KEY (sin NEXT_PUBLIC_); las NEXT_PUBLIC_ siguen
# valiendo como respaldo. service_role NUNCA acá — lesson KB.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase (respaldo, nombres viejos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend FastAPI (ingesta + moderación)
NEXT_PUBLIC_API_URL=http://localhost:8000
